sudo tee /etc/systemd/system/tv-cec.service >/dev/null <<'EOF'
[Unit]
Description=Register Pi as CEC playback device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/cec-ctl -d /dev/cec0 --playback
ExecStartPost=/usr/bin/ir-keytable -s rc0 -k 0x00=KEY_ENTER

[Install]
WantedBy=multi-user.target
EOF
sudo systemctl daemon-reload
sudo systemctl enable --now tv-cec.service

KEY_EPG